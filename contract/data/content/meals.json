      "html": "<div class=\"meal-grid\"><article class=\"meal\"><h3>7. Steak &amp;amp; Potatoes</h3>\n<div class=\"tw\"><table>\n<thead>\n<tr>\n<th>Ingredient</th>\n<th>Amount</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Lean beef (sirloin), raw</td>\n<td>200g</td>\n</tr>\n<tr>\n<td>White potato</td>\n<td>300g</td>\n</tr>\n<tr>\n<td>Green beans</td>\n<td>150g</td>\n</tr>\n<tr>\n<td>Butter</td>\n<td>10g</td>\n</tr>\n</tbody>\n</table></div>\n<p class=\"macro\">~670 kcal / ~50g protein</p></article>\n<article class=\"meal\"><h3>8. Salmon &amp;amp; Rice</h3>\n<div class=\"tw\"><table>\n<thead>\n<tr>\n<th>Ingredient</th>\n<th>Amount</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Salmon fillet, raw</td>\n<td>180g</td>\n</tr>\n<tr>\n<td>White rice, dry</td>\n<td>80g</td>\n</tr>\n<tr>\n<td>Asparagus</td>\n<td>150g</td>\n</tr>\n<tr>\n<td>Olive oil</td>\n<td>5g</td>\n</tr>\n</tbody>\n</table></div>\n<p class=\"macro\">~640 kcal / ~44g protein</p></article>\n<article class=\"meal\"><h3>9. Chicken Thigh Stir-Fry</h3>\n<div class=\"tw\"><table>\n<thead>\n<tr>\n<th>Ingredient</th>\n<th>Amount</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Chicken thigh, skinless, raw</td>\n<td>200g</td>\n</tr>\n<tr>\n<td>Mixed stir-fry vegetables</td>\n<td>200g</td>\n</tr>\n<tr>\n<td>White rice, dry</td>\n<td>80g</td>\n</tr>\n<tr>\n<td>Soy sauce</td>\n<td>15ml</td>\n</tr>\n<tr>\n<td>Sesame oil</td>\n<td>8g</td>\n</tr>\n</tbody>\n</table></div>\n<p class=\"macro\">~660 kcal / ~48g protein</p></article>\n\n</div>"
