    {
      "type": "list",
      "items": [
        {
          "text": "Mobility Primer: ankle dorsiflexion, 90/90 hip switches, couch stretch, world's greatest stretch, lateral lunge sweep, band lateral walks.",
          "html": "<li>Mobility Primer: ankle dorsiflexion, 90/90 hip switches, couch stretch, world&amp;#x27;s greatest stretch, lateral lunge sweep, band lateral walks.</li>"
        },
        {
          "text": "Deadlift and Back Squat need full rest (~2-2.5 min between sets) — don't shorten to save time.",
          "html": "<li>Deadlift and Back Squat need full rest (~2-2.5 min between sets) — don&amp;#x27;t shorten to save time.</li>"
        },
        {
          "text": "Box jumps and depth jumps need near-full recovery for jump quality — treat like main lifts, not accessories.",
          "html": "<li>Box jumps and depth jumps need near-full recovery for jump quality — treat like main lifts, not accessories.</li>"
        },
        {
          "text": "Plan for 45-55 min on Lift A/C days and 40-50 min on Lift B as a practical round number.",
          "html": "<li>Plan for 45-55 min on Lift A/C days and 40-50 min on Lift B as a practical round number.</li>"
        },
        {
          "text": "Real-world variable not included: equipment/rack availability at the gym.",
          "html": "<li>Real-world variable not included: equipment/rack availability at the gym.</li>"
        }
      ]
